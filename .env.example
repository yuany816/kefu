APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEV_API_KEY=change-me
DATABASE_URL=postgresql://merchant_ai:merchant_ai@localhost:5432/merchant_ai
# Docker Hub 连接慢时可设为 docker.m.daocloud.io/pgvector/pgvector:pg17
PGVECTOR_IMAGE=pgvector/pgvector:pg17
UPLOAD_DIR=./data/uploads

# local: no external credentials, useful for development
# openai_compatible: any provider implementing /v1/embeddings and /v1/chat/completions
AI_PROVIDER=local
AI_BASE_URL=
AI_API_KEY=
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSIONS=1024

AUTO_REPLY_PREFIX=【AI客服】
MIN_RETRIEVAL_SCORE=0.25
AGENT_COMMAND_LEASE_SECONDS=30

# 企业微信服务端 API（普通应用/客户联系 Secret）
WECOM_BASE_URL=https://qyapi.weixin.qq.com
WECOM_CORP_ID=
WECOM_CORP_SECRET=
WECOM_REQUEST_TIMEOUT_SECONDS=15

# 会话内容存档专用配置。普通 CorpSecret 不能替代 Archive Secret。
WECOM_ARCHIVE_SECRET=
WECOM_ARCHIVE_PRIVATE_KEY_PATH=
WECOM_FINANCE_SDK_PATH=

